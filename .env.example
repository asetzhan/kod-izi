# Copy to .env (`make dev` does it and fills the empty secrets automatically).
# Never commit .env. Production values are kept in a secrets store (spec 14.1).

APP_ENV=dev
HTTP_PORT=8080

POSTGRES_DB=kodizi
POSTGRES_USER=kodizi
POSTGRES_PASSWORD=

REDIS_PASSWORD=

# At least 32 characters.
JWT_SECRET=
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=7
LOGIN_MAX_ATTEMPTS=5
LOGIN_WINDOW_SECONDS=900
# false only for local http; true behind HTTPS.
COOKIE_SECURE=false

# Password for `make seed` demo accounts (dev only). Empty: a random one is printed.
DEMO_PASSWORD=

# Only `fake` exists in stage 0; real providers come in stage 3.
LLM_PROVIDER=fake

JUDGE0_DB_PASSWORD=
JUDGE0_REDIS_PASSWORD=
JUDGE0_AUTHN_TOKEN=
